[Unit]
Description=Token Admin Web Console
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tokenadmin
Group=tokenadmin
WorkingDirectory=/opt/token-admin/current
EnvironmentFile=/etc/token-admin.env
ExecStart=/opt/token-admin/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --workers 1 --no-access-log
Restart=always
RestartSec=4
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
ReadWritePaths=/var/lib/token-admin
LimitNOFILE=65535
MemoryMax=650M

[Install]
WantedBy=multi-user.target
