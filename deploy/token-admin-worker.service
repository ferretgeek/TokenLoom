[Unit]
Description=Token Admin Persistent Worker and Scheduler
After=network-online.target postgresql.service token-admin.service
Wants=network-online.target

[Service]
Type=simple
User=tokenadmin
Group=tokenadmin
WorkingDirectory=/opt/token-admin/current
EnvironmentFile=/etc/token-admin.env
ExecStart=/opt/token-admin/venv/bin/python -m app.worker
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
ReadWritePaths=/var/lib/token-admin
LimitNOFILE=65535
MemoryMax=900M

[Install]
WantedBy=multi-user.target
